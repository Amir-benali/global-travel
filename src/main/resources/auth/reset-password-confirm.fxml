<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<StackPane styleClass="reset-password-confirm-container" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.auth.ResetPasswordConfirm">
    <VBox styleClass="reset-password-confirm-card" maxWidth="400" maxHeight="400" alignment="CENTER" spacing="20">
        <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
            <image>
                <Image url="@../images/logo.jpg"/>
            </image>
        </ImageView>
        <Label text="Réinitialiser votre mot de passe" styleClass="title"/>
        <TextField fx:id="tokenField" promptText="Token de réinitialisation" styleClass="input-field"/>
        <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe" styleClass="input-field"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe" styleClass="input-field"/>
        <Button text="Réinitialiser" onAction="#handleResetPasswordConfirm" styleClass="reset-button"/>
        <Hyperlink text="Retour à la connexion" onAction="#handleBackToLogin"/>
    </VBox>
    <Circle styleClass="background-circle" radius="200" StackPane.alignment="TOP_RIGHT"/>
    <Circle styleClass="background-circle" radius="150" StackPane.alignment="BOTTOM_LEFT"/>
</StackPane>