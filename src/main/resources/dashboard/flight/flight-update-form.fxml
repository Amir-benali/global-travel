<?xml version="1.0" encoding="UTF-8"?>

                   <?import javafx.scene.layout.*?>
                   <?import javafx.scene.control.*?>
                   <?import javafx.scene.image.*?>
                   <?import javafx.geometry.Insets?>
                   <?import javafx.collections.FXCollections?>
                   <?import java.lang.String?>
                   <?import java.net.URL?>
                   <VBox styleClass="flight-form" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.flight.FlightUpdateForm">
                       <stylesheets>
                           <URL value="@/styles/FlightStyle.css"/>
                       </stylesheets>
                       <padding>
                           <Insets top="10" right="10" bottom="10" left="10"/>
                       </padding>

                       <GridPane hgap="10" vgap="10">
                           <Label fx:id="formTitleLabel" text="UPDATE FLIGHT" styleClass="form-title" GridPane.columnSpan="2"/>

                           <TextField fx:id="flightNumberField" styleClass="input-field small-text-field" GridPane.rowIndex="1" GridPane.columnIndex="1" disable="true"/>

                           <!-- Airline Name Field -->
                           <Label text="Airline Name:" styleClass="background-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                           <ComboBox fx:id="airline_nameField" styleClass="combo-box" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Select Airline"/>

                           <HBox spacing="18" GridPane.rowIndex="3" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                           <!-- Departure Country Field -->
                           <Label text="Departure Country:" styleClass="background-label"/>
                           <ComboBox fx:id="departure_countryField" styleClass="combo-box" promptText="Select Departure Country"/>

                           <!-- Arrival Country Field -->
                           <Label text="Arrival Country:" styleClass="background-label"/>
                           <ComboBox fx:id="arrival_countryField" styleClass="combo-box" promptText="Select Arrival Country"/>
                           </HBox>

                           <!-- Departure Airport Field -->
                           <HBox spacing="18" GridPane.rowIndex="4" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                           <Label text="Departure Airport:" styleClass="background-label"/>
                           <ComboBox fx:id="departureAirportField" styleClass="combo-box" promptText="Select Departure Airport"/>

                           <!-- Arrival Airport Field -->
                           <Label text="Arrival Airport:" styleClass="background-label"/>
                           <ComboBox fx:id="arrivalAirportField" styleClass="combo-box" promptText="Select Arrival Airport"/>
                           </HBox>
                           <!-- Departure Date and Time -->
                           <Label text="Departure Date:" styleClass="background-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                           <HBox spacing="5" GridPane.rowIndex="5" GridPane.columnIndex="1" alignment="CENTER_LEFT" >
                               <DatePicker fx:id="departureDatePicker" promptText="Date"/>
                               <Label text="Time:"/>
                               <ComboBox fx:id="departureHourComboBox" styleClass="combo-box" promptText="Hour">
                                   <items>
                                       <FXCollections fx:factory="observableArrayList">
                                           <String fx:value="00"/>
                                           <String fx:value="01"/>
                                           <String fx:value="02"/>
                                           <String fx:value="03"/>
                                           <String fx:value="04"/>
                                           <String fx:value="06"/>
                                           <String fx:value="07"/>
                                           <String fx:value="08"/>
                                           <String fx:value="09"/>
                                           <String fx:value="10"/>
                                           <String fx:value="11"/>
                                           <String fx:value="12"/>
                                           <String fx:value="13"/>
                                           <String fx:value="14"/>
                                           <String fx:value="15"/>
                                           <String fx:value="16"/>
                                           <String fx:value="17"/>
                                           <String fx:value="18"/>
                                           <String fx:value="19"/>
                                           <String fx:value="20"/>
                                           <String fx:value="21"/>
                                           <String fx:value="22"/>
                                           <String fx:value="23"/>
                                       </FXCollections>
                                   </items>
                               </ComboBox>
                               <Label text=":"/>
                               <ComboBox fx:id="departureMinuteComboBox" styleClass="combo-box" promptText="Minute">
                                   <items>
                                       <FXCollections fx:factory="observableArrayList">
                                           <String fx:value="00"/>
                                           <String fx:value="05"/>
                                           <String fx:value="10"/>
                                           <String fx:value="15"/>
                                           <String fx:value="20"/>
                                           <String fx:value="25"/>
                                           <String fx:value="30"/>
                                           <String fx:value="35"/>
                                           <String fx:value="40"/>
                                           <String fx:value="45"/>
                                           <String fx:value="50"/>
                                           <String fx:value="55"/>
                                       </FXCollections>
                                   </items>
                               </ComboBox>
                           </HBox>
                           <!-- Arrival Date and Time -->
                           <Label text="Arrival Date:" styleClass="background-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                           <HBox spacing="5" GridPane.rowIndex="6" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                               <DatePicker fx:id="arrivalDatePicker" promptText="Date"/>
                               <Label text="Time:"/>
                               <ComboBox fx:id="arrivalHourComboBox" styleClass="combo-box" promptText="Hour">
                                   <items>
                                       <FXCollections fx:factory="observableArrayList">
                                           <String fx:value="00"/>
                                           <String fx:value="01"/>
                                           <String fx:value="02"/>
                                           <String fx:value="03"/>
                                           <String fx:value="04"/>
                                           <String fx:value="05"/>
                                           <String fx:value="06"/>
                                           <String fx:value="07"/>
                                           <String fx:value="08"/>
                                           <String fx:value="09"/>
                                           <String fx:value="10"/>
                                           <String fx:value="11"/>
                                           <String fx:value="12"/>
                                           <String fx:value="13"/>
                                           <String fx:value="14"/>
                                           <String fx:value="15"/>
                                           <String fx:value="16"/>
                                           <String fx:value="17"/>
                                           <String fx:value="18"/>
                                           <String fx:value="19"/>
                                           <String fx:value="20"/>
                                           <String fx:value="21"/>
                                           <String fx:value="22"/>
                                           <String fx:value="23"/>
                                       </FXCollections>
                                   </items>
                               </ComboBox>
                               <Label text=":"/>
                               <ComboBox fx:id="arrivalMinuteComboBox" styleClass="combo-box" promptText="Minute">
                                   <items>
                                       <FXCollections fx:factory="observableArrayList">
                                           <String fx:value="00"/>
                                           <String fx:value="05"/>
                                           <String fx:value="10"/>
                                           <String fx:value="15"/>
                                           <String fx:value="20"/>
                                           <String fx:value="25"/>
                                           <String fx:value="30"/>
                                           <String fx:value="35"/>
                                           <String fx:value="40"/>
                                           <String fx:value="45"/>
                                           <String fx:value="50"/>
                                           <String fx:value="55"/>
                                       </FXCollections>
                                   </items>
                               </ComboBox>
                           </HBox>

                           <!-- Available Seats Field -->
                           <Label text="Available Seats:" styleClass="background-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                           <TextField fx:id="seatsNumberField" styleClass="input-field small-text-field" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                           <!-- Base Price Field -->
                           <Label text="Base Price:" styleClass="background-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                           <TextField fx:id="priceField" styleClass="input-field small-text-field" GridPane.rowIndex="8" GridPane.columnIndex="1" promptText="0.0$"/>

                           <!-- Flight Status ComboBox -->
                           <Label text="Flight Status:" styleClass="background-label" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                           <ComboBox fx:id="statusComboBox" styleClass="combo-box" GridPane.rowIndex="9" GridPane.columnIndex="1" promptText="Select Status">
                               <items>
                                   <FXCollections fx:factory="observableArrayList">
                                       <String fx:value="Scheduled"/>
                                       <String fx:value="Delayed"/>
                                       <String fx:value="Cancelled"/>
                                       <String fx:value="Completed"/>
                                   </FXCollections>
                               </items>
                           </ComboBox>

                           <!-- Image Selection Section -->
                           <Label text="Airline Logo:" styleClass="background-label" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                           <HBox spacing="5" GridPane.rowIndex="11" GridPane.columnIndex="1">
                               <Button text="Choose Airline Logo" styleClass="choose-image-button"/>
                               <Label fx:id="selectedImageLabel" text="No image selected" styleClass="selected-image-label"/>
                           </HBox>

                           <ImageView fx:id="airlineLogoPreview" fitHeight="100" fitWidth="200" preserveRatio="true" GridPane.rowIndex="11" GridPane.columnIndex="1"/>

                           <!-- Error Label -->
                           <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.rowIndex="11" GridPane.columnIndex="1">
                               <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
                               <Button fx:id="saveButton" text="Save Flight" onAction="#handleSaveFlight" styleClass="save-button"/>
                           </HBox>
                           <!-- Action Buttons -->

                       </GridPane>
                   </VBox>