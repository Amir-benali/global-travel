<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="20" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.flight.TicketCreateForm">
    <GridPane>
        <HBox alignment="CENTER_LEFT" spacing="50.0">
            <children>
                <Label styleClass="section-title" text="Create Ticket" />
                <Button onAction="#handleBack" styleClass="back-button" text="Back" />
            </children>
        </HBox>
        <children>
            <Label text="Flight ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="flightIdField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Seat Number:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="seatNumberField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Ticket Class:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="ticketClassField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Ticket Price:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <TextField fx:id="ticketPriceField" GridPane.rowIndex="3" GridPane.columnIndex="1" />

            <Label text="Ticket Status:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <TextField fx:id="ticketStatusField" GridPane.rowIndex="4" GridPane.columnIndex="1" />

            <Label text="Booking Date:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <TextField fx:id="bookingDateField" GridPane.rowIndex="5" GridPane.columnIndex="1" />

            <Button onAction="#handleSaveTicket" text="Save" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="2" />
            <Button onAction="#handleCancel" text="Cancel" GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="2" />
        </children>
    </GridPane>
</VBox>