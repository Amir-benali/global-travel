<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>

<VBox spacing="10" styleClass="hotel-form" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.hotel.HotelCreateForm">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Add New Hotel" styleClass="form-title"/>

    <!-- Hotel Name Field -->
    <TextField fx:id="hotelNameField" promptText="Hotel Name"/>

    <!-- Address Field -->
    <TextField fx:id="addressField" promptText="Address"/>

    <!-- City Field -->
    <TextField fx:id="cityField" promptText="City"/>

    <!-- Country Field -->
    <TextField fx:id="countryField" promptText="Country"/>

    <!-- Category Field -->
    <TextField fx:id="categoryField" promptText="Category (Stars)"/>

    <!-- Services Field -->
    <TextField fx:id="servicesField" promptText="Services"/>

    <!-- Coordinates Field -->
    <TextField fx:id="coordinatesField" promptText="Coordinates"/>

    <!-- Reviews Field -->
    <TextArea fx:id="reviewsField" promptText="Customer Reviews"/>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
        <Button fx:id="saveButton" text="Save Hotel" onAction="#handleSaveHotel" styleClass="save-button"/>
    </HBox>
</VBox>
