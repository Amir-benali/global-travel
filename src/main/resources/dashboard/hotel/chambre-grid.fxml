<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="chambres-grid-container" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.hotel.ChambreGrid">
    <content>
        <VBox spacing="20">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
                <children>
                    <Label styleClass="section-title" text="Chambre List" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#addChambre" styleClass="add-button" text="+ ADD CHAMBRE" />
                </children>
            </HBox>

            <FlowPane fx:id="chambresGrid" hgap="20" vgap="20">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
            </FlowPane>
        </VBox>
    </content>
</ScrollPane>