<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa;" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.hotel.ChambreGrid">
    <content>
        <VBox spacing="20">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- Header Section -->
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
                <children>
                    <!-- Styled Title -->
                    <Label text="Room List" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 4, 0, 2, 2);" />

                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Add Chamber Button -->
                    <Button fx:id="btnAddChamber" onAction="#addChambre" text="+ CHAMBER"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 5px;" />
                </children>
            </HBox>

            <!-- Room List Section -->
            <FlowPane fx:id="chambresGrid" hgap="20" vgap="20"
                      style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-radius: 5px; -fx-padding: 20px;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
            </FlowPane>
        </VBox>
    </content>
</ScrollPane>