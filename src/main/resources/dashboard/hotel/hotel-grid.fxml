<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="hotels-grid-container" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.hotel.HotelGrid">
    <content>
        <VBox spacing="20">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="50.0" styleClass="header">
                <children>
                    <Label styleClass="section-title" text="Hotel List" />
                    <Button onAction="#navigateToChambre" styleClass="add-button" text="Chambres" />
                    <TextField fx:id="searchField" promptText="Search by hotel name" />
                    <Button onAction="#searchHotelByName" styleClass="search-button" text="Search" />
                    <Button onAction="#addHotel" styleClass="add-button" text="+ ADD HOTEL" />
                    <Button onAction="#exportToPDF" styleClass="pdf-button" text="PDF" />
                    <!-- Ajouter un bouton pour afficher les statistiques -->
                    <Button onAction="#showHotelsByCategory" styleClass="statistics-button" text="Stats" />
                    <!-- Ajouter un bouton pour exporter les statistiques en PDF -->
                    <Button onAction="#exportStatisticsToPDF" styleClass="pdf-button" text="Stats PDF" />
                </children>
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>
            </HBox>

            <FlowPane fx:id="hotelsGrid" hgap="20" vgap="20">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
            </FlowPane>
        </VBox>
    </content>
</ScrollPane>