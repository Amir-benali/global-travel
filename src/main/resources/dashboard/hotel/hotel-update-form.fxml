<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="10" styleClass="hotel-form" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.hotel.HotelUpdateForm">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Update Hotel" styleClass="form-title"/>

    <!-- Hotel Name Field -->
    <TextField fx:id="nameField" promptText="Hotel Name"/>

    <!-- Address Field -->
    <TextField fx:id="addressField" promptText="Address"/>

    <!-- City Field -->
    <TextField fx:id="cityField" promptText="City"/>

    <!-- Country Field -->
    <TextField fx:id="countryField" promptText="Country"/>

    <!-- Category (Stars) Field -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Category (Stars):"/>
        <Spinner fx:id="categorySpinner" />
    </HBox>

    <!-- Available Amenities -->
    <TextField fx:id="amenitiesField" promptText="Available Amenities"/>

    <!-- Coordinates Field -->
    <TextField fx:id="locationField" promptText="Coordinates"/>

    <!-- Review Field -->
    <TextArea fx:id="reviewField" promptText="Reviews" wrapText="true"/>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
        <Button fx:id="saveButton" text="Save Hotel" onAction="#handleSaveHotel" styleClass="save-button"/>
    </HBox>
</VBox>