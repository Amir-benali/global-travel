<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.globalTravel.controllers.user.UserPaymentGrid" spacing="10" alignment="TOP_CENTER" style="-fx-background-color: #f4f4f4;">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- En-tête du chatbot -->
    <HBox alignment="CENTER" spacing="10">
        <!-- Icône du chatbot -->
        <StackPane>
            <Circle radius="25" fill="#4CAF50" />
            <ImageView fitWidth="30" fitHeight="30" preserveRatio="true">
                <image>
                    <Image url="@/images/chatbot-icon.png" /> <!-- Remplacez par le chemin de votre icône -->
                </image>
            </ImageView>
        </StackPane>
        <!-- Titre du chatbot -->
        <Label text="AI Chatbot" style="-fx-text-fill: #333333; -fx-font-size: 24px; -fx-font-weight: bold;" />
    </HBox>

    <!-- Zone de conversation -->
    <TextArea fx:id="outputArea" editable="false" wrapText="true" prefHeight="400" prefWidth="600" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 10px;" />

    <!-- Champ de texte pour l'entrée utilisateur -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="inputField" promptText="Type your message here..." prefWidth="500" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 10px;" />
        <!-- Bouton pour envoyer la requête -->
        <Button text="Send" onAction="#handleSendRequest" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px;">
            <graphic>
                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                    <image>
                        <Image url="@/images/send-icon.png" /> <!-- Remplacez par le chemin de votre icône -->
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

    <!-- Bouton pour effacer les champs -->
    <Button text="Clear Chat" onAction="#handleClear" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px;" />
</VBox>