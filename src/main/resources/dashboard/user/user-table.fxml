<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="content" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.globalTravel.controllers.user.UserTable">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Top Controls -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="selectionLabel" text="0 sélectionné" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField  fx:id="searchField" promptText="Rechercher..." />
    </HBox>

    <!-- Table -->
    <TableView fx:id="userTable" styleClass="user-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="firstNameColumn" text="Prénom" prefWidth="120.0" />
            <TableColumn fx:id="lastNameColumn" text="Nom" prefWidth="120.0" />
            <TableColumn fx:id="genreColumn" text="Genre" prefWidth="80.0" />
            <TableColumn fx:id="dateNaissanceColumn" text="Date de Naissance" prefWidth="150.0" />
            <TableColumn fx:id="adresseColumn" text="Adresse" prefWidth="200.0" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200.0" />
            <TableColumn fx:id="phoneNumberColumn" text="Téléphone" prefWidth="150.0" />
            <TableColumn fx:id="rolesColumn" text="Rôle" prefWidth="150.0" />
            <TableColumn fx:id="statutColumn" text="Statut" prefWidth="100.0" />
            <TableColumn fx:id="actionColumn" text="Actions" prefWidth="150.0" /> <!-- New Action Column -->
        </columns>
        <VBox.margin>
            <Insets top="20" />
        </VBox.margin>
    </TableView>

    <!-- Pagination -->
    <HBox alignment="CENTER" spacing="5" styleClass="pagination">
        <Button styleClass="pagination-button" text="Précédent" />
        <Button styleClass="pagination-button, current" text="1" />
        <Button styleClass="pagination-button" text="2" />
        <Button styleClass="pagination-button" text="3" />
        <Button styleClass="pagination-button" text="4" />
        <Button styleClass="pagination-button" text="5" />
        <Button styleClass="pagination-button" text="6" />
        <Button styleClass="pagination-button" text="7" />
        <Button styleClass="pagination-button" text="Suivant" />
    </HBox>
</VBox>