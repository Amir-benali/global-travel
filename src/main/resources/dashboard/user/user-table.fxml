<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="content" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.globalTravel.controllers.user.UserTable">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Top Controls -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="selectionLabel" text="5 sélectionné" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchField" promptText="Rechercher..." />
        <Button onAction="#handleAddUser" styleClass="add-button" text="+ AJOUTER" />
    </HBox>

    <!-- Table -->
    <TableView fx:id="userTable" styleClass="user-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn>
                <graphic>
                    <CheckBox fx:id="selectAllCheckbox" />
                </graphic>
            </TableColumn>
            <TableColumn fx:id="nameColumn" prefWidth="202.0" text="Nom des utilisateurs" />
            <TableColumn fx:id="emailColumn" prefWidth="238.0" text="Adresse E-mail" />
            <TableColumn fx:id="phoneColumn" prefWidth="219.0" text="Numéro de téléphone" />
            <TableColumn fx:id="roleColumn" prefWidth="206.0" text="Role" />
            <TableColumn fx:id="actionColumn" prefWidth="162.0" text="Action" />
        </columns>
        <VBox.margin>
            <Insets top="20" />
        </VBox.margin>
    </TableView>

    <!-- Pagination -->
    <HBox alignment="CENTER" spacing="5" styleClass="pagination">
        <Button styleClass="pagination-button" text="Précédent" />
        <Button styleClass="pagination-button, current" text="1" />
        <Button styleClass="pagination-button" text="2" />
        <Button styleClass="pagination-button" text="3" />
        <Button styleClass="pagination-button" text="4" />
        <Button styleClass="pagination-button" text="5" />
        <Button styleClass="pagination-button" text="6" />
        <Button styleClass="pagination-button" text="7" />
        <Button styleClass="pagination-button" text="Suivant" />
    </HBox>
</VBox>