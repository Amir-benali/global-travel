<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>

<?import java.lang.String?>
<VBox spacing="10" styleClass="car-form" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.car.CarCreateForm">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Add New Private Car" styleClass="form-title"/>

    <!-- Brand Field -->
    <VBox>
        <TextField fx:id="brandField" promptText="Brand"/>
        <VBox fx:id="brandErrorContainer"/>
    </VBox>

    <!-- Model Field -->
    <VBox>
        <TextField fx:id="modelField" promptText="Model"/>
        <VBox fx:id="modelErrorContainer"/>
    </VBox>

    <!-- Number of Seats Field -->
    <VBox>
        <TextField fx:id="numSeatsField" promptText="Number of Seats"/>
        <VBox fx:id="numSeatsErrorContainer"/>
    </VBox>

    <!-- Driver ComboBox -->
    <VBox>
        <ComboBox fx:id="driverComboBox" promptText="Select Driver">
            <items>
                <FXCollections fx:factory="observableArrayList"/>
            </items>
        </ComboBox>
        <VBox fx:id="driverErrorContainer"/>
    </VBox>

    <!-- Image Selection Section -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Choose car image" onAction="#handleChooseImage" styleClass="choose-image-button"/>
        <Label fx:id="selectedImageLabel" text="No image selected" styleClass="selected-image-label"/>
    </HBox>
    <VBox fx:id="carImageErrorContainer"/>

    <ImageView fx:id="driverImagePreview" fitHeight="100" fitWidth="200" preserveRatio="true"/>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
        <Button fx:id="saveButton" text="Save Car" onAction="#handleSaveCar" styleClass="save-button"/>
    </HBox>
</VBox>
