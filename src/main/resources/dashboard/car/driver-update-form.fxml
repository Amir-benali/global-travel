<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.text.Text?>

<VBox spacing="10" styleClass="car-form" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.car.DriverUpdateForm">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Update Car Driver" styleClass="form-title"/>

    <!-- First Name Field -->
    <VBox>
        <TextField fx:id="firstNameField" promptText="First Name"/>
        <VBox fx:id="firstNameErrorContainer"/>
    </VBox>

    <!-- Last Name Field -->
    <VBox>
        <TextField fx:id="lastNameField" promptText="Last Name"/>
        <VBox fx:id="lastNameErrorContainer"/>
    </VBox>

    <!-- Phone Field -->
    <VBox>
        <TextField fx:id="phoneField" promptText="Phone"/>
        <VBox fx:id="phoneErrorContainer"/>
    </VBox>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
        <Button fx:id="saveButton" text="Save Driver" onAction="#handleSaveDriver" styleClass="save-button"/>
    </HBox>
</VBox>