<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.paint.*?>
<?import javafx.geometry.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.Group?>

<ScrollPane fitToWidth="true" pannable="true" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.globalTravel.controllers.car.CarSeatSelection"
    style="-fx-background-color: #f3f4f6; -fx-padding: 0;">
    <content>
        <VBox spacing="20" style="-fx-background-color: #f3f4f6; -fx-padding: 20;">
            <!-- Title and Back Button -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
              <Label text="Select Your Seats" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Back to List" style="-fx-text-fill: #2563eb; -fx-background-color: transparent; -fx-padding: 0;" onAction="#handleBackAction">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_LEFT" size="16" fill="#2563eb"/>
                    </graphic>
                </Button>
            </HBox>

            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" halignment="CENTER"/>
                    <ColumnConstraints percentWidth="50" halignment="CENTER"/>
                </columnConstraints>

                <!-- Left Column - Vehicle Visualization -->
                <ScrollPane GridPane.columnIndex="0" fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
                    <content>
                        <VBox spacing="20">
                            <!-- Vehicle Visualization -->
                            <StackPane style="-fx-background-color: linear-gradient(to bottom, #e0f2fe, #f3f4f6); -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-min-height: 600;">
                                <!-- Vehicle Blueprint Background -->
                                <Group fx:id="vehicleBlueprint">
                                    <!-- Will be dynamically populated in the controller -->
                                </Group>

                                <!-- Seat Layout -->
                                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">
                                    <!-- Front Row -->
                                    <HBox alignment="CENTER" spacing="30">
                                        <!-- Driver Seat -->
                                        <VBox alignment="CENTER" spacing="5" fx:id="driverSeat">
                                            <StackPane style="-fx-background-color: #9ca3af; -fx-border-color: #6b7280; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-min-width: 32; -fx-min-height: 36; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1); -fx-cursor: not-allowed;">
                                                <FontAwesomeIconView glyphName="CAR" size="16" fill="#374151"/>
                                            </StackPane>
                                            <Label text="A1" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                            <Label text="Driver" style="-fx-font-size: 10px; -fx-text-fill: #374151;"/>
                                        </VBox>

                                        <!-- Front Passenger Seat -->
                                        <VBox alignment="CENTER" spacing="5" fx:id="passengerSeat">
                                            <StackPane style="-fx-background-color: white; -fx-border-color: #3b82f6; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-min-width: 32; -fx-min-height: 36; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1); -fx-cursor: hand;">
                                                <Label text="A2" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                                            </StackPane>
                                            <Label text="A2" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                            <Label text="0.00" style="-fx-font-size: 10px; -fx-text-fill: #1d4ed8;"/>
                                        </VBox>
                                    </HBox>

                                    <!-- Middle Row -->
                                    <HBox alignment="CENTER" spacing="30" fx:id="middleRow">
                                        <!-- Will be dynamically populated in the controller -->
                                    </HBox>

                                    <!-- Third Row (added) -->
                                    <HBox alignment="CENTER" spacing="30" fx:id="thirdRow">
                                        <!-- Will be dynamically populated in the controller -->
                                    </HBox>

                                    <!-- Fourth Row (added) -->
                                    <HBox alignment="CENTER" spacing="30" fx:id="fourthRow">
                                        <!-- Will be dynamically populated in the controller -->
                                    </HBox>
                                </VBox>
                            </StackPane>

                            <!-- Legend -->
                            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <FontAwesomeIconView glyphName="FLAG" size="20" fill="#1f2937"/>
                                    <Label text="Seat Legend" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                                </HBox>
                                <FlowPane hgap="25" vgap="10" style="-fx-padding: 10 0 0 0;">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Rectangle width="20" height="20" arcWidth="5" arcHeight="5" fill="WHITE" stroke="#93c5fd" strokeWidth="2"/>
                                        <Label text="Available" style="-fx-font-size: 14px; -fx-text-fill: #374151;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Rectangle width="20" height="20" arcWidth="5" arcHeight="5" fill="#dbeafe" stroke="#3b82f6" strokeWidth="2"/>
                                        <Label text="Selected" style="-fx-font-size: 14px; -fx-text-fill: #374151;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <StackPane style="-fx-background-color: #d1d5db; -fx-border-color: #9ca3af; -fx-border-width: 2; -fx-background-radius: 5; -fx-border-radius: 5; -fx-min-width: 20; -fx-min-height: 20;">
                                            <FontAwesomeIconView glyphName="CAR" size="12" fill="#374151"/>
                                        </StackPane>
                                        <Label text="Driver" style="-fx-font-size: 14px; -fx-text-fill: #374151;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Rectangle width="20" height="20" arcWidth="5" arcHeight="5" fill="#d1d5db" stroke="#9ca3af" strokeWidth="2"/>
                                        <Label text="Reserved" style="-fx-font-size: 14px; -fx-text-fill: #374151;"/>
                                    </HBox>
                                </FlowPane>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- Right Column - Seat Information and Employee Assignment -->
                <ScrollPane GridPane.columnIndex="1" fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
                    <content>
                        <VBox spacing="15">
                            <!-- Seat Information -->
                            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <FontAwesomeIconView glyphName="INFO_CIRCLE" size="20" fill="#1f2937"/>
                                    <Label text="Seat Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                                </HBox>
                                <GridPane hgap="10" vgap="10" style="-fx-padding: 10 0 0 0;">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50"/>
                                        <ColumnConstraints percentWidth="50"/>
                                    </columnConstraints>
                                    <VBox style="-fx-background-color: linear-gradient(to bottom right, #e0f2fe, #bfdbfe); -fx-background-radius: 8; -fx-padding: 12;">
                                        <Label text="Total Seats" style="-fx-font-size: 12px; -fx-text-fill: #4b5563;"/>
                                        <Label fx:id="totalSeatsLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
                                    </VBox>
                                    <VBox style="-fx-background-color: linear-gradient(to bottom right, #e0f2fe, #bfdbfe); -fx-background-radius: 8; -fx-padding: 12;">
                                        <Label text="Available" style="-fx-font-size: 12px; -fx-text-fill: #4b5563;"/>
                                        <Label fx:id="availableSeatsLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <!-- Selected Seats and Employee Assignment -->
                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>

                                <!-- Selected Seats -->
                                <VBox GridPane.columnIndex="0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <FontAwesomeIconView glyphName="CHECK_CIRCLE" size="20" fill="#1f2937"/>
                                        <Label text="Selected Seats" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                                    </HBox>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;" maxHeight="200">
                                        <content>
                                            <VBox fx:id="selectedSeatsContainer" style="-fx-background-color: linear-gradient(to bottom right, #f9fafb, #f3f4f6); -fx-background-radius: 8; -fx-padding: 15; -fx-spacing: 10;">
                                                <Label text="No seats selected yet" style="-fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-alignment: CENTER; -fx-padding: 15 0;"/>
                                            </VBox>
                                        </content>
                                    </ScrollPane>
                                </VBox>

                                <!-- Employee Assignment -->
                                <VBox GridPane.columnIndex="1" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <FontAwesomeIconView glyphName="USER" size="20" fill="#1f2937"/>
                                        <Label text="Assign Employees" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                                    </HBox>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;" maxHeight="200">
                                        <content>
                                            <VBox fx:id="employeeSelectionContainer" style="-fx-background-color: linear-gradient(to bottom right, #f9fafb, #f3f4f6); -fx-background-radius: 8; -fx-padding: 15; -fx-spacing: 10;">
                                                <Label fx:id="noSeatsMessage" text="Select seats to assign employees" style="-fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-alignment: CENTER; -fx-padding: 15 0;"/>
                                                <!-- Employee assignments will be dynamically added by the controller -->
                                            </VBox>
                                        </content>
                                    </ScrollPane>
                                </VBox>
                            </GridPane>

                            <!-- Continue Button -->
                            <Button fx:id="continueButton" text="Continue"
                                    style="-fx-background-color: #9ca3af; -fx-text-fill: #4b5563; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: default;"
                                    disable="true" onAction="#handleContinueAction">
                                <graphic>
                                    <FontAwesomeIconView glyphName="ARROW_RIGHT" size="16" fill="#4b5563"/>
                                </graphic>
                            </Button>
                        </VBox>
                    </content>
                </ScrollPane>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
