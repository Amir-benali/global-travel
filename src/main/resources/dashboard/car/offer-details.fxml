<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="main-container" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.car.OfferDetails">
    <VBox spacing="20">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Offer Details" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox spacing="30" alignment="CENTER_LEFT">
            <ImageView fx:id="offerImage" fitWidth="300" fitHeight="200" preserveRatio="true">
                <image>
                    <Image url="@/images/carlogo.png"/>
                </image>
            </ImageView>
            <VBox spacing="10" styleClass="offer-summary" HBox.hgrow="ALWAYS">
                <Label fx:id="priceLabel" styleClass="price-label"/>
                <Label fx:id="dateLabel" styleClass="date-label"/>
                <Label fx:id="routeLabel" styleClass="route-label"/>
                <Button fx:id="bookButton" text="Book Now" styleClass="action-button, book-button"/>
            </VBox>
        </HBox>

        <VBox styleClass="details-section">
            <Label text="Offer Details" styleClass="section-title"/>
            <GridPane vgap="10" hgap="20">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="150"/>
                    <ColumnConstraints minWidth="200" prefWidth="300"/>
                </columnConstraints>

                <Label text="ID:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="idLabel" styleClass="field-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Description:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="descriptionLabel" styleClass="field-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <VBox styleClass="details-section">
            <Label text="Route Information" styleClass="section-title"/>
            <GridPane vgap="10" hgap="20">
                <Label text="From:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="routeFromLabel" styleClass="field-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="To:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="routeToLabel" styleClass="field-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Distance:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="routeDistanceLabel" styleClass="field-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <VBox styleClass="details-section">
            <Label text="Car Information" styleClass="section-title"/>
            <GridPane vgap="10" hgap="20">
                <Label text="Brand:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="carBrandLabel" styleClass="field-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Model:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="carModelLabel" styleClass="field-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Seats:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="carSeatsLabel" styleClass="field-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Driver:" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="carDriverLabel" styleClass="field-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="backButton" text="Back to Offers" styleClass="action-button, back-button"/>
        </HBox>
    </VBox>
</ScrollPane>