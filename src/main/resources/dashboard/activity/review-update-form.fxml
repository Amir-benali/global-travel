<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.controlsfx.control.Rating?>

<VBox spacing="10" styleClass="review-form" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.activity.ReviewUpdateForm">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Update Review" styleClass="form-title"/>

    <!-- Champ pour le commentaire -->
    <TextField fx:id="commentaireField" promptText="Review Comment"/>

    <!-- Rating pour la note -->
    <Rating fx:id="noteRating" max="5" rating="0" />

    <!-- ComboBox pour Activity ID (liste des IDs existants) -->
    <ComboBox fx:id="activityIdComboBox" promptText="Select Activity ID"/>

    <!-- DatePicker pour la date (désactivé) -->
    <DatePicker fx:id="dateReviewPicker" promptText="Review Date" disable="true"/>

    <!-- Boutons d'action -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
        <Button fx:id="saveButton" text="Save Review" onAction="#handleSaveReview" styleClass="save-button"/>
    </HBox>
</VBox>