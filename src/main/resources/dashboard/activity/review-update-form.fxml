<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import java.net.URL?>
<?import org.controlsfx.control.Rating?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.activity.ReviewUpdateForm">
    <!-- Lier le fichier CSS pour le style -->
    <stylesheets>
        <URL value="@/styles/styles.css"/>
    </stylesheets>


    <VBox spacing="20" styleClass="review-form" alignment="CENTER">
        <!-- Espacement autour du formulaire -->
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Titre du formulaire avec icône -->
        <HBox alignment="TOP_CENTER" spacing="10">
            <ImageView fitHeight="50" fitWidth="50">
                <Image url="@/icons/update.png"/> <!-- Icône pour la critique -->
            </ImageView>
            <Label fx:id="formTitleLabel" text="Update Review" styleClass="form-title-activty"/>
        </HBox>

        <!-- Section : Commentaire -->
        <VBox spacing="10" styleClass="form-section-activty">
            <VBox spacing="10" styleClass="form-section-review">
                <Label text="Commentaire" styleClass="section-label-review"/>
                <TextArea fx:id="commentaireField" promptText="Review Comment" styleClass="form-field-review"/>
            </VBox>
        </VBox>

        <!-- Section : Note -->
        <VBox spacing="10" styleClass="form-section-activty">
            <VBox spacing="10" styleClass="form-section-review">
                <Label text="Note" styleClass="section-label-review"/>
                <Rating fx:id="noteRating" max="5" rating="0" styleClass="rating-field-review"/>
            </VBox>
        </VBox>

        <!-- Section : ID de l'activité -->
        <VBox spacing="10" styleClass="form-section-activty">
            <VBox spacing="10" styleClass="form-section-review">
                <Label text="Activité" styleClass="section-label-review"/>
                <ComboBox fx:id="activityIdComboBox" promptText="Select Activity ID" styleClass="form-field-review">
                    <!-- Cette ComboBox sera peuplée dynamiquement -->
                </ComboBox>
            </VBox>
        </VBox>

        <!-- Section : Date de la critique -->
        <VBox spacing="10" styleClass="form-section-activty">
            <VBox spacing="10" styleClass="form-section-review">
                <Label text="Date de la critique" styleClass="section-label-review"/>
                <DatePicker fx:id="dateReviewPicker" promptText="Review Date" disable="true" styleClass="form-field-review"/>
            </VBox>
        </VBox>

        <!-- Boutons d'action -->
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <!-- Bouton Annuler sans icône -->
            <Button text="Annuler" onAction="#handleCancel" styleClass="cancel-button-activty"/>

            <!-- Bouton Enregistrer sans icône -->
            <Button fx:id="saveButton" text="Enregistrer" onAction="#handleSaveReview" styleClass="save-button-activty"/>
        </HBox>

        <!-- Label pour afficher le statut (Succès, Erreur, etc.) -->
        <Label fx:id="statusLabel" text="" styleClass="status-label-review"/>
    </VBox>
</ScrollPane>