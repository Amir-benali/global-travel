<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.image.ImageView?>
<?import java.net.URL?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns:fx="http://javafx.com/fxml" fx:controller="com.globalTravel.controllers.activity.ActivityCreateForm">

    <!-- Lier le fichier CSS pour le style -->
    <stylesheets>

    </stylesheets>

    <VBox spacing="20" alignment="CENTER" styleClass="activity-form">

        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Titre du formulaire avec icône -->
        <HBox alignment="CENTER" spacing="10">

            <Label fx:id="formTitleLabel" text="New Activity" styleClass="form-title-activty"/>
        </HBox>

        <!-- Section : Informations de base -->
        <VBox spacing="10" styleClass="form-section-activty">
            <Label text="Informations de base" styleClass="section-label-activty"/>
            <TextField fx:id="activityNameField" promptText="Nom de l'activité" styleClass="form-field-activty"/>
            <ComboBox fx:id="activityNameSuggestionsComboBox" promptText="Suggestions de nom" styleClass="form-field-activty"
                      visible="false" prefWidth="300"/>
            <TextArea fx:id="descriptionField" promptText="Description" styleClass="description-field-activty"/>
            <TextField fx:id="localisationField" promptText="Localisation" styleClass="form-field-activty" onKeyReleased="#handleLocationInput"/>
            <ComboBox fx:id="suggestionsComboBox" promptText="Sélectionnez une localisation" styleClass="form-field-activty"
                      visible="false" prefWidth="300"/>
        </VBox>

        <!-- Section : Date et Heure de début -->
        <VBox spacing="10" styleClass="form-section-activty">
            <Label text="Date et Heure de début" styleClass="section-label-activty"/>
            <DatePicker fx:id="startDatePicker" promptText="Date de début" styleClass="form-field-activty"/>
            <HBox spacing="10" alignment="CENTER">
                <ComboBox fx:id="startHourComboBox" promptText="Heure" styleClass="time-combo-activty"/>
                <ComboBox fx:id="startMinuteComboBox" promptText="Minute" styleClass="time-combo-activty"/>
                <ComboBox fx:id="startSecondComboBox" promptText="Seconde" styleClass="time-combo-activty"/>
            </HBox>
        </VBox>

        <!-- Section : Date et Heure de fin -->
        <VBox spacing="10" styleClass="form-section-activty">
            <Label text="Date et Heure de fin" styleClass="section-label-activty"/>
            <DatePicker fx:id="endDatePicker" promptText="Date de fin" styleClass="form-field-activty"/>
            <HBox spacing="10" alignment="CENTER">
                <ComboBox fx:id="endHourComboBox" promptText="Heure" styleClass="time-combo-activty"/>
                <ComboBox fx:id="endMinuteComboBox" promptText="Minute" styleClass="time-combo-activty"/>
                <ComboBox fx:id="endSecondComboBox" promptText="Seconde" styleClass="time-combo-activty"/>
            </HBox>
        </VBox>

        <!-- Section : Prix -->
        <VBox spacing="10" styleClass="form-section-activty">
            <Label text="Prix" styleClass="section-label-activty"/>
            <TextField fx:id="priceField" promptText="Prix" styleClass="form-field-activty"/>
        </VBox>

        <!-- Section : Sélection des IDs -->
        <VBox spacing="10" styleClass="form-section-activty">
            <Label text="Sélection des Hotel-Voiture-Vols" styleClass="section-label-activty"/>
            <ComboBox fx:id="hotelIdComboBox" promptText="Nom de l'Hôtel" styleClass="form-field-activty"/>
            <ComboBox fx:id="carIdComboBox" promptText="Marque de Voiture" styleClass="form-field-activty"/>
            <ComboBox fx:id="flightIdComboBox" promptText="Numéro de Vol" styleClass="form-field-activty"/>
        </VBox>

        <!-- Section : Type d'Activité -->
        <VBox spacing="10" styleClass="form-section-activty">
            <Label text="Type d'Activité" styleClass="section-label-activty"/>
            <ComboBox fx:id="typeComboBox" promptText="Type d'Activité" styleClass="form-field-activty"/>
        </VBox>

        <!-- Boutons d'action -->
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Button text="Annuler" onAction="#handleCancel" styleClass="cancel-button-activty"/>
            <Button fx:id="saveButton" text="Enregistrer" onAction="#handleSaveActivity" styleClass="save-button-activty"/>
        </HBox>

        <!-- Label pour afficher le statut -->
        <Label fx:id="statusLabel" text="" styleClass="status-label-activty"/>
    </VBox>
</ScrollPane>
